@startuml state_robot
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма состояний: робот

[*] --> НаСтарте : любая правка решения или поля /\n«Новый путь»
state "На старте" as НаСтарте
state "Идёт (пауза)" as Пауза
state "Идёт сам" as Бежит
state "Дошёл до выхода" as Дошёл
state "Остановлен" as Стоп
НаСтарте --> Пауза : «Шаг робота»
НаСтарте --> Бежит : «Пустить»
Пауза --> Пауза : «Шаг робота»
Пауза --> Бежит : «Пустить»
Бежит --> Пауза : «Пауза» / «Шаг робота»
Бежит --> Бежит : кадр / шаги по скорости
Бежит --> Дошёл : пришёл в +1 или −1
Пауза --> Дошёл : пришёл в +1 или −1
Бежит --> Стоп : 1000 шагов без выхода
Пауза --> Стоп : 1000 шагов без выхода
Дошёл --> НаСтарте : «Новый путь» / правка
Стоп --> НаСтарте : «Новый путь» / правка
@enduml
